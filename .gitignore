# Build output — regenerated by `prepack` (see package.json `files`).
lib/

# Dependencies
node_modules/

# Logs and diagnostics
*.log
npm-debug.log*
pnpm-debug.log*
.npm/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*~

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Test / coverage artifacts
coverage/
.nyc_output/
*.tsbuildinfo

# Local scratch: measurement runs and the adopt command's sandbox live here.
# pnpm drops a content-addressable store beside whichever directory it installs
# into, so installing inside the sandbox leaves one here too.
.tmp/
.pnpm-store/

# CI unpacks the npm tarball here to check the published entry actually imports
.dist-check/
*.tgz

# CodeGraph's index. It carries its own .gitignore for the database, but the
# directory would still show up as untracked, and a machine-local index has no
# business in a published repository either way.
.codegraph/
